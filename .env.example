# =============================================================
# Enterprise Vault – Environment Variables Template
# =============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit your actual .env file to Git!
# =============================================================

# -------------------------------------------------------------
# Database
# -------------------------------------------------------------
# Local development (SQLite, relative to project root):
DATABASE_URL="file:./dev.db"

# Production / Docker (absolute path inside container):
# DATABASE_URL="file:/app/prisma/prod.db"

# -------------------------------------------------------------
# NextAuth.js
# -------------------------------------------------------------
# Generate a secure secret (run once):
#   openssl rand -base64 32
#
# ⚠️  CRITICAL: This value is also used as the AES-256-GCM
#     master encryption key for all secrets in the vault.
#     Changing it in production will make ALL stored secrets
#     permanently undecryptable!
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public URL of the app (no trailing slash)
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Production example:
# NEXTAUTH_URL="https://vault.your-domain.com"
