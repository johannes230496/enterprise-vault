# =============================================================
# Enterprise Vault – Environment Variables Template
# =============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit your actual .env file to Git!
# =============================================================

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
# Local development (via docker-compose):
DATABASE_URL="postgresql://vault:changeme@localhost:5432/enterprise_vault"

# Production (Coolify injects this automatically when you link a PostgreSQL resource):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# -------------------------------------------------------------
# PostgreSQL password (used by docker-compose only)
# -------------------------------------------------------------
POSTGRES_PASSWORD="changeme"

# -------------------------------------------------------------
# NextAuth.js
# -------------------------------------------------------------
# Generate a secure secret (run once):
#   openssl rand -base64 32
#
# ⚠️  CRITICAL: This value is also used as the AES-256-GCM
#     master encryption key for all secrets in the vault.
#     Changing it in production will make ALL stored secrets
#     permanently undecryptable!
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Public URL of the app (no trailing slash)
# Local:
NEXTAUTH_URL="http://localhost:3000"
# Production example:
# NEXTAUTH_URL="https://vault.your-domain.com"
